# Copy to .env and fill in only what you need. With nothing set, the red team uses
# its deterministic offline mock backend.

# Option A: Anthropic API
ANTHROPIC_API_KEY=

# Option B: Vertex AI (uses the ambient service account on Cloud Run)
VERTEX_PROJECT=
VERTEX_REGION=global
VERTEX_MODEL=gemini-3.6-flash
# Optional: a different model for the attacker than the judge
ATTACKER_MODEL=
ATTACKER_REGION=

# Live target (HTTPTarget / deploy/service)
TARGET_URL=
TARGET_USER_ID=alice
TARGET_PASSWORD=
TRIGGER_KEY=
